# Template file for 'aseprite'
pkgname=aseprite
version=1.3.18.6
revision=1
build_style=cmake
configure_args="-DLAF_BACKEND=skia -DENABLE_UPDATER=OFF -DENABLE_NEWS=OFF
 -DUSE_SHARED_CMARK=ON -DUSE_SHARED_GIFLIB=ON -DUSE_SHARED_ZLIB=ON
 -DUSE_SHARED_LIBPNG=ON -DUSE_SHARED_PIXMAN=ON"
hostmakedepends="pkg-config ninja clang unzip"
makedepends="libX11-devel libXcursor-devel libXi-devel libXrandr-devel
 MesaLib-devel fontconfig-devel zlib-devel libpng-devel giflib-devel
 pixman-devel cmark-devel"
short_desc="Animated sprite editor & pixel art tool"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:EULA"
homepage="https://www.aseprite.org"
changelog="https://aseprite.org/release-notes"
distfiles="https://github.com/aseprite/aseprite/releases/download/v${version}/Aseprite-v${version}-Source.zip
 https://github.com/aseprite/skia/releases/download/m124-08a5439a6b/Skia-Linux-Release-x64.zip>skia-m124.zip"
checksum="fa9dd07a0c2a5ec91a4166333296bbb9e5c237933b59875d0cfee849d2358306
 a327e89b244f24cecaa34eb37544bae00d447b96c583d26ed29d6a3ad2e8a8b8"
restricted=yes
skip_extraction="skia-m124.zip"

case "$XBPS_TARGET_MACHINE" in
	x86_64*) ;;
	*) broken="prebuilt Skia libraries are only available for x86_64" ;;
esac

post_extract() {
	mkdir -p ${wrksrc}/skia-m124
	vsrcextract --no-strip-components -C ${wrksrc}/skia-m124 skia-m124.zip
}

pre_configure() {
	# prebuilt skia libraries are built with clang so use clang to link against them
	export CC=clang
	export CXX=clang++
	# wrksrc not defined in configure_args above so set these here
	configure_args+=" -DSKIA_DIR=${wrksrc}/skia-m124"
	configure_args+=" -DSKIA_LIBRARY_DIR=${wrksrc}/skia-m124/out/Release-x64"
	configure_args+=" -DSKIA_LIBRARY=${wrksrc}/skia-m124/out/Release-x64/libskia.a"
}

do_install() {
	# bundled libraries leak a bunch of bs so only install what we need
	vbin build/bin/aseprite
	# copy data to the right place
	vmkdir usr/share/aseprite/data
	vcopy "data/*" usr/share/aseprite/data
	vlicense EULA.txt
	vinstall ${FILESDIR}/aseprite.desktop 644 usr/share/applications
	for size in 16 32 48 64 128 256; do
		vinstall data/icons/ase${size}.png 644 usr/share/icons/hicolor/${size}x${size}/apps aseprite.png
	done
}
